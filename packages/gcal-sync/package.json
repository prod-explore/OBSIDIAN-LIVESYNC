{
  "name": "obsidian-gcal-sync",
  "version": "1.0.0",
  "description": "Google Calendar and Tasks bi-sync for Obsidian",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "get-token": "tsx scripts/get-refresh-token.ts",
    "typecheck": "tsc --noEmit",
    "test:coverage": "npm run build && c8 node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "googleapis": "^187.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
