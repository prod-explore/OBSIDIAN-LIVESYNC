# Reverse proxy for the Obsidian stack: the MCP server under /mcp/ and CouchDB (LiveSync) for everything else.
#
# Needs nginx 1.25.1 or newer (the "http2 on" directive). Assumes nginx runs as a container that joined the
# shared "obsidian" Docker network (see docker-compose.yml), so "obsidian-mcp" and "obsidian-couchdb" resolve
# through Docker's DNS. Replace obsidian.example.com with your domain and get the certificate first (the HTTP
# block below serves the ACME challenge):
#   certbot certonly --webroot -w /var/www/certbot -d obsidian.example.com
#
# For a complete hardened proxy (rate limits, TLS settings, default server) see
# https://github.com/prod-explore/nginx-reverse-proxy - this file is the part specific to this stack.

# The upstream names are variables, so nginx starts (and keeps working) while a container is restarting.
resolver 127.0.0.11 valid=10s ipv6=off;

# Clients that cannot send headers pass the MCP token as ?token=..., and a normal access log would write it down.
# This format logs the path only.
log_format obsidian_mcp '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    listen [::]:80;
    server_name obsidian.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name obsidian.example.com;

    ssl_certificate     /etc/letsencrypt/live/obsidian.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/obsidian.example.com/privkey.pem;

    # LiveSync uploads notes in chunks; raise this if sync reports 413.
    client_max_body_size 100m;

    # MCP server. Streamable HTTP and legacy SSE both hold the connection open: no buffering, no
    # compression, no idle timeout shorter than the server's own session sweep (1 hour).
    location /mcp/ {
        set $mcp http://obsidian-mcp:3000;
        proxy_pass $mcp;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        access_log /var/log/nginx/obsidian-mcp.access.log obsidian_mcp;
    }

    # CouchDB, for the LiveSync plugin on your devices. Long-polling for changes needs the same treatment.
    location / {
        set $couch http://obsidian-couchdb:5984;
        proxy_pass $couch;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
