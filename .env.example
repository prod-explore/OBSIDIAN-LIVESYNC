# Copy to .env and fill in. Generate every secret with:  openssl rand -base64 32

# --- Required -----------------------------------------------------------------

# Token MCP clients present (Authorization: Bearer ... or ?token=...)
MCP_API_KEY=

# CouchDB (the LiveSync database)
COUCHDB_USER=admin
COUCHDB_PASSWORD=

# Login for the headless Obsidian GUI (KasmVNC); only needed while setting the vault up
VNC_USER=admin
VNC_PASSWORD=

# --- Optional: MCP server -------------------------------------------------------

# Text every MCP client receives on connect (the MCP "instructions" field), next to the tool list.
# Unset: "read _Systems/AGENTS.md if the vault has one". The file is yours; the server never creates it.
# Set your own wording, or the value none to send nothing.
# MCP_INSTRUCTIONS=

# --- Optional: logging (both services) --------------------------------------------

# debug, info, warn, error or silent. One JSON object per line in a container (LOG_FORMAT=text for a person).
# The ?token= of an MCP URL and anything named like a secret is masked in every line.
# LOG_LEVEL=info

# --- Optional: Google Calendar & Tasks sync (obsidian-gcal-sync) -----------------
# Skip these and start the other services only if you do not want the sync:
#   docker compose up -d couchdb obsidian-headless obsidian-mcp

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Printed by `npm run get-token --workspace packages/gcal-sync`
GOOGLE_REFRESH_TOKEN=
CALENDAR_IDS=primary
TASKLIST_IDS=@default
# Whole minutes, 1-59
POLL_INTERVAL_MINUTES=5

# Notes of tasks/events that Google deleted or cancelled stay in the vault as a record. Those with nothing
# written in their body are removed after this many days (0 = keep for ever). A note with text is never removed.
# CANCELLED_RETENTION_DAYS=30

# Safety net: push refuses to delete most of a list on Google when its notes vanish from the vault
# at once (an unmounted volume looks exactly like that). Set to true for ONE run after an
# intended bulk deletion, then remove it.
# ALLOW_MASS_DELETE=true
