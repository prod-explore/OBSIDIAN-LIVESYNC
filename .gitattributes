# Force LF line endings in the repo (source of truth for the Pi/Linux target).
# Windows users with core.autocrlf=true still get CRLF in their working tree
# — this only controls what goes into Git objects.

* text=auto eol=lf

# Explicitly binary — never mangle these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.gz    binary
*.zip   binary