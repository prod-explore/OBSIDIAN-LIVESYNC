# Matches .prettierrc.json and .gitattributes: LF, two spaces, 120 columns.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,js,json,yml,yaml}]
max_line_length = 120

[*.md]
# A trailing double space is a line break in Markdown.
trim_trailing_whitespace = false
