{
  "name": "obsidian-mcp",
  "version": "1.0.0",
  "description": "MCP server that gives AI clients safe read/write access to an Obsidian vault",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
